# Plantilla local: no contiene credenciales operativas.
# npm run env:local genera .env con una contraseña aleatoria, sin sobrescribirlo.
NODE_ENV=development
PORT=3014
DB_HOST=127.0.0.1
DB_PORT=5444
DB_USERNAME=catalog_local
DB_PASSWORD=REPLACE_WITH_LOCAL_RANDOM_PASSWORD
DB_DATABASE=ms_catalog
# Neon: al definir DATABASE_URL, reemplaza las variables DB_* anteriores.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/ms_catalog?sslmode=require
DB_POOL_MAX=5
AMQP_URL=amqps://USER:PASSWORD@example.rmq.cloudamqp.com/VHOST
AMQP_QUEUE=ms_catalog.events
AMQP_PREFETCH=10
AMQP_EXCHANGE=booking.events
CATALOG_EVENTS_QUEUE=booking.catalog.events
AMQP_AUDIT_QUEUE=booking.audit.events
IDENTITY_BASE_URL=http://localhost:3011/api/v2
BOOKING_API_KEY=replace-with-the-same-key-configured-in-ms-identity
INVENTORY_GRPC_URL=inventory.railway.internal:50051
INVENTORY_GRPC_TLS=false
INVENTORY_PROTO_PATH=../../contracts/inventory.proto
INVENTORY_SERVICE_ID=NODE_ATR_GLORIA
AMQP_CATALOG_QUEUE=catalog.reviews

# Or�genes permitidos para el navegador (separados por coma)
CORS_ORIGINS=http://localhost:4200
